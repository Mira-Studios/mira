            "h",
            "cpp",
            "hpp",
            "cs",
            "sh",
            "bash",
            "ps1",
            "sql",
            "rb",
            "php",
            "vue",
            "svelte"
          ],
          "name": "Text and source code",
          "role": "Editor",
          "mimeType": "text/plain"
        }
      ],
      "target": [
        "portable",
        "nsis"
      ]
    },
    "nsis": {
      "artifactName": "${productName}-${version}-win-${arch}-setup.${ext}",
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": false,
      "include": "build/installer.nsh"
    },
