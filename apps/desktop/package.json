{
  "name": "mira",
  "description": "A browser",
  "author": "Mira Community <mirathebrowser@gmail.com>",
  "license": "MIT",
  "private": true,
  "version": "1.3.1",
  "type": "module",
  "main": "electron/main.ts",
  "homepage": "https://mira.fatalmistake02.com",
  "repository": "https://github.com/FatalMistake02/mira",
  "scripts": {
    "dev:react": "vite",
    "dev:electron": "wait-on http://localhost:5173 && electron .",
    "dev": "concurrently \"npm run dev:react\" \"npm run dev:electron\"",
    "build": "vite build && electron-builder",
    "build:renderer": "vite build",
    "build:fast": "vite build && electron-builder --publish never --dir --win",
    "build:portable": "vite build && electron-builder --publish never --win portable --config.compression=store",
    "build:nsis": "vite build && electron-builder --publish never --win nsis",
    "lint": "eslint .",
    "test:youtube-ads": "electron tests/youtubeAdBeta.electron.ts",
    "test:devtools": "electron tests/devTools.electron.ts",
    "test:file-editors": "electron tests/fileEditors.electron.ts",
    "test:git": "node --test tests/localGit.test.ts",
    "test:git-ui": "electron tests/gitRepositories.electron.ts",
    "test:background-images": "electron electron/backgroundImages.smoke.ts",
    "test:profiles": "node --test tests/profileStore.test.ts",
    "test:profiles-ui": "node tests/profiles.integration.ts",
    "test:sidebar": "node tests/sidebar.integration.ts",
    "test:workspaces": "node --test tests/workspaceStore.test.ts",
    "test:workspaces-ui": "node tests/workspaces.integration.ts",
    "test:window-restore": "node tests/windowRestore.integration.ts",
    "test:pip": "node --test tests/pictureInPicturePolicy.test.ts",
    "test:pip-ui": "node tests/pictureInPicture.integration.ts",
    "test:quick-navigate-ui": "node tests/quickNavigate.integration.ts",
    "test:find-ui": "node tests/findInPage.integration.ts",
    "test:site-permissions": "node --test tests/sitePermissionPolicy.test.ts",
    "test:site-permissions-ui": "node tests/sitePermissions.integration.ts",
    "test:tab-prompts": "node --test tests/tabPromptScope.test.ts",
    "test:tab-prompts-ui": "node tests/tabPrompts.integration.ts",
    "test:address-placement": "node --test tests/addressBarPlacement.test.ts",
    "test:address-placement-ui": "node tests/addressBarPlacement.integration.ts",
    "test:pinned-tabs-ui": "node tests/pinnedTabs.integration.ts",
    "test:getting-started": "node --test tests/gettingStarted.test.ts",
    "test:getting-started-ui": "node tests/gettingStarted.integration.ts",
    "preview": "vite preview",
    "format": "prettier --write \"src/**/*.{ts,tsx,js,jsx,json,css,md}\"",
    "test:updates": "node --test tests/updatePolicy.test.ts",
    "test:updates-ui": "electron tests/updateProgress.electron.ts"
  },
  "build": {
    "appId": "com.fatalmistake02.mira",
    "productName": "Mira",
    "icon": "assets/mira_icon.png",
    "npmRebuild": false,
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "!electron/**/*.test.ts",
      "!electron/**/*.smoke.ts",
      "src/assets/trackers.txt",
      "package.json"
    ],
    "protocols": [
      {
        "name": "Mira URL Handler",
        "schemes": [
          "http",
          "https",
          "mailto",
          "mira"
        ]
      }
    ],
    "win": {
      "artifactName": "${productName}-${version}-win-${arch}.${ext}",
      "icon": "assets/app_icons/app_icons.ico",
      "fileAssociations": [
        {
          "ext": [
            "htm",
            "html",
            "shtml"
          ],
          "name": "HTML Document",
          "role": "Viewer",
          "mimeType": "text/html"
        },
        {
          "ext": [
            "xht",
            "xhtml"
          ],
          "name": "XHTML Document",
          "role": "Viewer",
          "mimeType": "application/xhtml+xml"
        },
        {
          "ext": [
            "pdf"
          ],
          "name": "PDF Document",
          "role": "Viewer",
          "mimeType": "application/pdf"
        },
        {
          "ext": [
            "svg"
          ],
          "name": "SVG Document",
          "role": "Viewer",
          "mimeType": "image/svg+xml"
        },
        {
          "ext": [
            "mht",
            "mhtml"
          ],
          "name": "MHTML Document",
          "role": "Viewer",
          "mimeType": "multipart/related"
        },
        {
          "ext": [
            "xml"
          ],
          "name": "XML Document",
          "role": "Viewer",
          "mimeType": "application/xml"
        },
        {
          "ext": [
            "txt",
            "text",
            "md",
            "markdown",
            "json",
            "jsonc",
            "js",
            "jsx",
            "mjs",
            "cjs",
            "ts",
            "tsx",
            "css",
            "scss",
            "less",
            "yaml",
            "yml",
            "toml",
            "ini",
            "conf",
            "cfg",
            "log",
